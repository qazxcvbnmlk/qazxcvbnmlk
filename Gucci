-- HELL SEND AURA LOGIC
local vu390 = {
    localPlayer = Player,
    Players = Players,
    auraRadius = 25,
    SetNetworkOwner = RS:WaitForChild("GrabEvents", 5) and RS.GrabEvents:WaitForChild("SetNetworkOwner", 5),
    active = false,
    thread = nil
}

local vu12 = { CurrentCamera = Workspace.CurrentCamera }

local function startHellSendAura()
    vu390.active = true
    vu390.thread = task.spawn(function()
        while vu390.active do
            local success, err = pcall(function()
                local char = vu390.localPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local cam = vu12.CurrentCamera
                    for _, targetPlr in pairs(vu390.Players:GetPlayers()) do
                        if targetPlr ~= vu390.localPlayer and targetPlr.Character then
                            local tChar = targetPlr.Character
                            local torso = tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso")
                            if torso and (torso.Position - hrp.Position).Magnitude <= vu390.auraRadius then
                                if vu390.SetNetworkOwner then
                                    vu390.SetNetworkOwner:FireServer(torso, hrp.CFrame)
                                end
                                for _, part in ipairs(tChar:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end
                                local pos = torso:FindFirstChild("HellAuraPos") or Instance.new("BodyPosition")
                                pos.Name = "HellAuraPos"
                                pos.MaxForce = Vector3.new(100000, 100000, 100000)
                                pos.D = 500
                                pos.P = 50000
                                pos.Parent = torso

                                local gyro = torso:FindFirstChild("HellAuraGyro") or Instance.new("BodyGyro")
                                gyro.Name = "HellAuraGyro"
                                gyro.MaxTorque = Vector3.new(100000, 100000, 100000)
                                gyro.D = 500
                                gyro.P = 50000
                                gyro.Parent = torso

                                local look = cam.CFrame.LookVector
                                pos.Position = hrp.Position + (look * 15) + Vector3.new(0, 5, 0)
                                gyro.CFrame = CFrame.new(torso.Position, hrp.Position)
                            end
                        end
                    end
                end
            end)
            if not success then
                warn("Hell Aura Error: " .. tostring(err))
            end
            task.wait(0.03)
        end
    end)
end

local function stopHellSendAura()
    vu390.active = false
    if vu390.thread then
        task.cancel(vu390.thread)
        vu390.thread = nil
    end
end

