-- Global Registry & Helpers
local ToggleStates = {}
local function SetToggleState(flag, val)
    ToggleStates[flag] = val
end

local function notify(title, text, duration)
    Rayfield:Notify({
        Title = title,
        Content = text,
        Duration = duration or 3
    })
end

local function FWC(parent, childName, timeout)
    if not parent then return nil end
    return parent:WaitForChild(childName, timeout or 5)
end

local function grab(part)
    if not part then return end
    pcall(function()
        if RS:FindFirstChild("GrabEvents") and RS.GrabEvents:FindFirstChild("SetNetworkOwner") then
            RS.GrabEvents.SetNetworkOwner:FireServer(part)
        end
    end)
end

local function ResetPlayer(plr)
    if plr and plr.Character then
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
    end
end

