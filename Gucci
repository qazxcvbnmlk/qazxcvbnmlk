Tab1:CreateToggle({
    Name = "auto Gucci(Invisible)",
    Flag = "AutoGucci",
    CurrentValue = false,
    Callback = function(Value)
        SetToggleState("AutoGucci", Value)
        autoGucciEnabled = Value
        
        if Value then
            local isActive = false
            local function gucci()
                if not autoGucciEnabled or isActive then return end
                isActive = true
                local char = Player.Character
                if not char then isActive = false return end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                local head = char:FindFirstChild("Head")
                local inv = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                
                if not (hrp and hum and head and inv) then isActive = false return end

                cleanupGucciTasks()
                for _, v in pairs(inv:GetChildren()) do
                    if v.Name == "AutoGucci" or v.Name == "TractorGreen" then
                        pcall(function() RS.MenuToys.DestroyToy:FireServer(v) end)
                    end
                end
                
                local tractor = SpawnGucciToy("TractorGreen", hrp)
                if tractor then
                    tractor.Name = "AutoGucci"
                    local seat = tractor:FindFirstChildWhichIsA("VehicleSeat") or tractor:FindFirstChildWhichIsA("Seat")
                    if seat then
                        seat:Sit(hum)
                        task.wait(0.1)
                        autoGucciSpamTask = task.spawn(function()
                            while autoGucciEnabled and tractor and tractor.Parent do
                                pcall(function()
                                    head.CFrame = CFrame.new(head.Position.X, 100000, head.Position.Z)
                                end)
                                task.wait(0.01)
                            end
                        end)
                    end
                end
                isActive = false
            end
            task.spawn(gucci)
            notify("Auto Gucci", "Auto Gucci (Invisible) Enabled", 3)
        else
            cleanupGucciTasks()
            gucciRunId = gucciRunId + 1
            local inv = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
            if inv then
                for _, v in pairs(inv:GetChildren()) do
                    if v.Name == "AutoGucci" or v.Name == "Gucci" then
                        pcall(function() RS.MenuToys.DestroyToy:FireServer(v) end)
                    end
                end
            end
            notify("Auto Gucci", "Auto Gucci (Invisible) Disabled", 3)
        end
    end
})

